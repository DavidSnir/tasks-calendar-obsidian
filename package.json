{
  "name": "tasks-calendar-obsidian",
  "version": "0.2.0",
  "description": "Displays Obsidian Tasks in a calendar view with drag-and-drop support.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "lint": "eslint ."
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "tasks",
    "calendar"
  ],
  "author": "David Snir",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.1",
    "builtin-modules": "3.3.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "obsidian": "latest",
    "tslib": "2.4.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  }
}
